# 🌐 Configuração do servidor
NODE_ENV=
PORT=Minha.porta

# Database
DB_HOST=db.host
DB_PORT=db.port
DB_DATABASE=db.database
DB_USER=db.user
DB_PASSWORD=db.password

# ✉️ SMTP - usar Ethereal (gratuito)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=porta.smtp
SMTP_USER=usuario.smtp
SMTP_PASS=senha.smtp
SMTP_SECURE=boolean.smtp

# 👤 Remetente padrão
MAIL_FROM_NAME=MeuApp Teste
MAIL_FROM_EMAIL=email.smtp

# 🔹 Urls templates
APP_DASHBOARD_URL=dashboard.url
APP_SUPPORT_EMAIL=suporte

# 🌍 URL base da aplicação
APP_BASE_URL=url.app
